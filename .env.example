# === RECLAIM Environment Configuration Template ===
# Copy this file to .env and fill in your values.

# --- Database (SQLite default for local, or PostgreSQL for Docker) ---
DATABASE_URL=sqlite+aiosqlite:///./reclaim.db
# DATABASE_URL=postgresql+asyncpg://reclaim:reclaim@postgres:5432/reclaim

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Razorpay (test-mode keys) ---
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- LLM Settings (Gemini default, Groq optional) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- App ---
APP_ENV=dev
# APP_ENV=prod
